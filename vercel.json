{
  "version": 2,
  "builds": [
    {
      "src": "federation-backend/src/index.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["federation-backend/src/**"]
      }
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/.well-known/webfinger",
      "dest": "/federation-backend/src/index.ts"
    },
    {
      "src": "/.well-known/nodeinfo",
      "dest": "/federation-backend/src/index.ts"
    },
    {
      "src": "/nodeinfo/(.*)",
      "dest": "/federation-backend/src/index.ts"
    },
    {
      "src": "/users/(.*)",
      "dest": "/federation-backend/src/index.ts"
    },
    {
      "src": "/servers/(.*)",
      "dest": "/federation-backend/src/index.ts"
    },
    {
      "src": "/inbox",
      "dest": "/federation-backend/src/index.ts"
    },
    {
      "src": "/outbox",
      "dest": "/federation-backend/src/index.ts"
    },
    {
      "src": "/link-preview(.*)",
      "dest": "/federation-backend/src/index.ts"
    },
    {
      "src": "/api/livekit/(.*)",
      "dest": "/federation-backend/src/index.ts"
    },
    {
      "src": "/api/federation/(.*)",
      "dest": "/federation-backend/src/index.ts"
    },
    {
      "src": "/push/(.*)",
      "dest": "/federation-backend/src/index.ts"
    },
    {
      "src": "/health",
      "dest": "/federation-backend/src/index.ts"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ],
  "env": {
    "NODE_ENV": "production",
    "USE_PGBOSS_QUEUE": "false"
  },
  "regions": ["iad1"]
}
