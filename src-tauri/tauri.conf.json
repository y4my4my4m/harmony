{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Harmony",
  "version": "1.6.2",
  "identifier": "online.knowmad.harmony",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Harmony",
        "width": 1280,
        "height": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": false,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Knowmad",
    "copyright": "",
    "category": "SocialNetworking",
    "shortDescription": "Federated Discord-like chat app",
    "longDescription": "A federated, Discord-like chat application with real-time messaging, voice calls, and ActivityPub integration",
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "exceptionDomain": "",
      "entitlements": "Entitlements.plist"
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "wix": {
        "language": "en-US"
      }
    },
    "iOS": {
      "minimumSystemVersion": "13.0"
    },
    "android": {
      "minSdkVersion": 24
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/y4my4my4m/harmony/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk3REZCNkZFM0QzQzg3MDUKUldRRmh6dzkvcmJmbCsvNXBybmtYVnd5dGo3SFlzcFRSWmpSVHNrZVhjVmphNEQ5UXR4WndZV0IK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
