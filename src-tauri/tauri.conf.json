{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",

  "productName": "harmony",
  "version": "0.1.0",
  "identifier": "online.knowmad.harmony",

  "build": {
    "beforeBuildCommand": "bun build",
    "beforeDevCommand": "bun dev",
    "devUrl": "https://har.mony.lol",
    "frontendDist": "../dist"
  },

  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "harmony",
        "width": 1280,
        "height": 720,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },

  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "icon": [
      "icons/icon.icns"
    ],
    "resources": [],
    "shortDescription": "",
    "longDescription": "",
    "targets": "all",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null
    },
    "linux": {
      "appimage": {
        "files": {}
      },
      "deb": {
        "files": {}
      },
      "rpm": {
        "epoch": 0,
        "release": "1",
        "files": {}
      }
    }
  },

  "plugins": {}
}
