    .limit(remainingSlots)
  
  popularPosts = data || []
}

const featuredPosts = [...(pinnedPosts || []), ...popularPosts]
*/

-- =====================================================
-- STEP 5: VERIFICATION AND COMPLETION
-- =====================================================

-- Grant permissions on the new function
GRANT EXECUTE ON FUNCTION get_featured_posts(UUID, INT) TO authenticated;
GRANT EXECUTE ON FUNCTION get_featured_posts(UUID, INT) TO anon;

-- Test the function (optional)
-- SELECT * FROM get_featured_posts('your-user-uuid'::UUID, 5);

DO $$
BEGIN
    RAISE NOTICE '✅ FEATURED POSTS SYSTEM SETUP COMPLETE';
    RAISE NOTICE '✅ Added is_pinned column to posts table';
    RAISE NOTICE '✅ Created optimized indexes for performance';
    RAISE NOTICE '✅ Created get_featured_posts() helper function';
    RAISE NOTICE '';
    RAISE NOTICE 'IMPLEMENTATION OPTIONS:';
    RAISE NOTICE '1. Use database function: SELECT * FROM get_featured_posts(user_id, 5)';
    RAISE NOTICE '2. Use two-query approach in TypeScript (see comments above)';
    RAISE NOTICE '3. Pin posts by setting: UPDATE posts SET is_pinned = true WHERE id = ?';
    RAISE NOTICE '';
    RAISE NOTICE 'BENEFITS:';
    RAISE NOTICE '• Pinned posts appear first when available';
    RAISE NOTICE '• Falls back to popular posts when no pinned posts';
    RAISE NOTICE '• Always returns up to 5 posts as featured content';
    RAISE NOTICE '• Optimized with proper indexes for performance';
END $$;
