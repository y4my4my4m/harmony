-- Complete Fix for Featured Endpoint - Both Database Schema and Smart Query
-- This addresses the immediate issue and adds future pinned posts support

-- =====================================================
-- STEP 1: ADD IS_PINNED COLUMN AND INDEX
-- =====================================================

-- Add is_pinned column to support pinned posts
ALTER TABLE posts ADD COLUMN IF NOT EXISTS is_pinned BOOLEAN DEFAULT FALSE;

-- Create optimized index for pinned posts queries
CREATE INDEX IF NOT EXISTS idx_posts_pinned 
ON posts(author_id, is_pinned, created_at DESC) 
WHERE is_pinned = true;

-- Create general index for featured posts (popular content)
CREATE INDEX IF NOT EXISTS idx_posts_featured 
ON posts(author_id, interactions_count DESC, created_at DESC) 
WHERE interactions_count > 0;

-- =====================================================
-- STEP 2: SMART FEATURED POSTS QUERY (BEST OF BOTH)
-- =====================================================

-- Use this hybrid query in your featured endpoint:
-- It shows pinned posts first, then fills with popular posts

/*
-- SMART FEATURED POSTS QUERY (Hybrid Approach)
-- This query prioritizes pinned posts, then fills with popular posts

