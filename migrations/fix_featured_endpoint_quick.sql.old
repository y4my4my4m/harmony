        interactions_count, replies_count,
        1 as priority,
        created_at as sort_date
    FROM posts
    WHERE author_id = $1 AND is_pinned = true
    ORDER BY created_at DESC
    LIMIT 5
),
popular_posts AS (
    SELECT 
        id, content, created_at, updated_at, author_id,
        interactions_count, replies_count,
        2 as priority,
        created_at as sort_date
    FROM posts
    WHERE author_id = $1 
    AND is_pinned = false
    AND interactions_count > 0
    AND id NOT IN (SELECT id FROM pinned_posts)
    ORDER BY interactions_count DESC, created_at DESC
    LIMIT (5 - (SELECT COUNT(*) FROM pinned_posts))
)
SELECT 
    id, content, created_at, updated_at, author_id,
    interactions_count, replies_count
FROM (
    SELECT * FROM pinned_posts
    UNION ALL
    SELECT * FROM popular_posts
) combined
ORDER BY priority, sort_date DESC
LIMIT 5;
*/

-- SIMPLIFIED VERSION (easier to implement in TypeScript):
/*
-- First try to get pinned posts
SELECT 
    id, content, created_at, updated_at, author_id,
    interactions_count, replies_count,
    'pinned' as source
FROM posts
WHERE author_id = $1 AND is_pinned = true
ORDER BY created_at DESC
LIMIT 5;

-- If fewer than 5 pinned posts, fill with popular posts:
SELECT 
    id, content, created_at, updated_at, author_id,
    interactions_count, replies_count,
    'popular' as source
FROM posts
WHERE author_id = $1 
AND is_pinned = false
AND interactions_count > 0
ORDER BY interactions_count DESC, created_at DESC
LIMIT $2; -- Where $2 = (5 - number_of_pinned_posts)
*/

-- =====================================================
-- STEP 3: CREATE HELPER FUNCTION (OPTIONAL)
-- =====================================================

-- Create a database function for easy featured posts retrieval
CREATE OR REPLACE FUNCTION get_featured_posts(user_id UUID, max_posts INT DEFAULT 5)
RETURNS TABLE (
    id UUID,
    content JSONB,
    created_at TIMESTAMPTZ,
    updated_at TIMESTAMPTZ,
    author_id UUID,
    interactions_count INT,
    replies_count INT,
    is_pinned BOOLEAN,
    source TEXT
)
LANGUAGE plpgsql
AS $$
DECLARE
    pinned_count INT;
    remaining_slots INT;
BEGIN
    -- Get pinned posts first
    RETURN QUERY
    SELECT 
        p.id, p.content, p.created_at, p.updated_at, p.author_id,
        p.interactions_count, p.replies_count, p.is_pinned,
        'pinned'::TEXT as source
    FROM posts p
    WHERE p.author_id = user_id AND p.is_pinned = true
    ORDER BY p.created_at DESC
    LIMIT max_posts;
    
    -- Count how many pinned posts we got
    GET DIAGNOSTICS pinned_count = ROW_COUNT;
    remaining_slots := max_posts - pinned_count;
    
    -- Fill remaining slots with popular posts if needed
    IF remaining_slots > 0 THEN
        RETURN QUERY
        SELECT 
            p.id, p.content, p.created_at, p.updated_at, p.author_id,
            p.interactions_count, p.replies_count, p.is_pinned,
            'popular'::TEXT as source
        FROM posts p
        WHERE p.author_id = user_id 
        AND p.is_pinned = false
        AND p.interactions_count > 0
        ORDER BY p.interactions_count DESC, p.created_at DESC
        LIMIT remaining_slots;
    END IF;
END;
$$;

