# =============================================================================
# Harmony federation backend
# =============================================================================
# Copy to .env. Loader: src/config/index.ts. Details of each variable:
# docs-source/guide/environment.md. A commented line shows the default.
# =============================================================================

# --- Supabase (required) ------------------------------------------------------
# API URL as this process reaches it: http://supabase-kong:8000 on Supabase's Docker network.
SUPABASE_URL=https://your-project.supabase.co
# Anon key; GET /instance-info hands it to native clients.
SUPABASE_ANON_KEY=your-anon-key-here
# Service role key. Secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Public Supabase URL for storage URLs and native clients; set it when SUPABASE_URL is internal.
# PUBLIC_SUPABASE_URL=<SUPABASE_URL>
# Realtime endpoint override.
# SUPABASE_REALTIME_URL=

# --- Instance -----------------------------------------------------------------
# Public domain without scheme (required). ActivityPub ids derive from it.
INSTANCE_DOMAIN=harmony.example.com
# Name in /health and /instance-info, and in NodeInfo when instance_config has none.
INSTANCE_NAME=Harmony
# NodeInfo description when instance_config has none.
# INSTANCE_DESCRIPTION=A federated social platform

# --- Server -------------------------------------------------------------------
# development, production or test.
NODE_ENV=production
# HTTP port.
PORT=3001
# server (HTTP only), worker (queues only) or unified (both). The root compose files set it.
# FEDERATION_MODE=unified
# Comma-separated browser origins; Tauri origins are always allowed.
CORS_ORIGIN=https://harmony.example.com
# Express `trust proxy`: peers trusted to set X-Real-IP, on which rate limits key.
TRUST_PROXY=loopback, uniquelocal
# Rate limit window, ms.
# RATE_LIMIT_WINDOW_MS=900000
# Requests per window.
# RATE_LIMIT_MAX_REQUESTS=100
# error, warn, info or debug.
LOG_LEVEL=info

# --- Queue and database -------------------------------------------------------
# Redis for BullMQ, cache, presence and rate limits; in Docker redis://:PASSWORD@redis:6379.
REDIS_URL=redis://localhost:6379
# false: Supabase Realtime subscription instead of the queue (no persistence). Fallback: USE_PGBOSS_QUEUE.
# USE_BULLMQ_QUEUE=true
# Session-mode Postgres URL (port 5432) for LISTEN federation_jobs; empty: 60 s sweep. Fallback: DATABASE_URL.
# Role harmony_listener, created by self-host/bootstrap.sh or the SQL in docs-source/guide/deployment/supabase.md:
#   postgresql://harmony_listener:PASSWORD@supabase-db:5432/postgres
FEDERATION_LISTENER_URL=

# --- Federation and media -----------------------------------------------------
# false accepts unsigned inbound activities; refused with NODE_ENV=production.
# REQUIRE_VALID_SIGNATURES=true
# HMAC key (32+ chars) of attachment URLs sent to other instances; empty: derived from the service role key.
MEDIA_URL_SECRET=
# Public prefix of this backend in those URLs.
# MEDIA_PUBLIC_BASE_URL=https://<INSTANCE_DOMAIN>/api/federation
# Bearer secret of POST /link-preview/enrich-message, equal to the bot gateway's; empty: the service role key.
INTERNAL_API_SECRET=

# --- Push notifications -------------------------------------------------------
# Web Push key pair (npx web-push generate-vapid-keys); empty disables Web Push and UnifiedPush.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address, with or without mailto:.
VAPID_SUBJECT=admin@harmony.example.com
# Firebase service account JSON for the Android app (FCM): inline, raw or base64.
FCM_SERVICE_ACCOUNT_JSON=
# Path to that JSON file; FCM_SERVICE_ACCOUNT_JSON wins when both are set.
FCM_SERVICE_ACCOUNT_FILE=
# true accepts push endpoints on private, loopback or link-local addresses.
# PUSH_ALLOW_PRIVATE_ENDPOINTS=false

# --- Voice and video (LiveKit) ------------------------------------------------
# A key pair from `keys` in livekit.yaml; LiveKit counts as configured with key, secret and URL set.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# LiveKit as this process reaches it, e.g. ws://livekit:7880.
LIVEKIT_URL=
# URL clients connect to, e.g. wss://live.harmony.example.com; empty: LIVEKIT_URL.
LIVEKIT_PUBLIC_URL=
# sfu (LiveKit), p2p, or hybrid (LiveKit when configured, else peer-to-peer).
WEBRTC_MODE=hybrid
# Voice and video calls with users on other instances.
# ALLOW_FEDERATED_VOICE=true
# Worker: seconds between voice_channel_participants checks against LiveKit rooms; 0 disables.
# VOICE_RECONCILE_INTERVAL_SECONDS=60

# --- GIFs and AI emoji (Klipy) ------------------------------------------------
# Key with ads, served to regular users. One key serves everyone; none disables GIF search.
KLIPY_API_KEY_ADS=
# Key without ads, served to supporters whose tier removes ads.
KLIPY_API_KEY_NOADS=
# Klipy API base.
# KLIPY_BASE_URL=https://api.klipy.com
# Token in the AI emoji callback URL; empty: derived from the service role key.
AI_EMOJI_WEBHOOK_SECRET=
