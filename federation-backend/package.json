{
  "name": "harmony-federation-backend",
  "version": "1.0.0",
  "description": "Harmony federated social platform - ActivityPub Federation Backend (FEDERATION ONLY)",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src/**/*.ts",
    "diagnose": "tsx diagnose-federation.ts",
    "diagnose-deep": "tsx diagnose-deep.ts",
    "check-remote": "tsx check-remote-users.ts",
    "check-misskey": "tsx check-misskey-follows.ts",
    "refresh-users": "tsx refresh-remote-users.ts"
  },
  "keywords": [
    "activitypub",
    "federation",
    "fediverse",
    "mastodon",
    "misskey"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.39.2",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "node-cache": "^5.1.2",
    "web-push": "^3.6.7",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "prettier": "^3.1.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
