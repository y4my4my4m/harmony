{
  "name": "harmony",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "format": "prettier --write src/",
    "docs:generate": "typedoc --options typedoc.json",
    "docs:serve": "cd docs/api && python -m http.server 8080",
    "docs:lint": "markdownlint docs/**/*.md",
    "docs:fix": "markdownlint docs/**/*.md --fix",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:generate-api": "typedoc --options typedoc.json",
    "docs:generate-all": "npm run docs:generate-api && npm run docs:build",
    "docs:legacy": "concurrently \"npm run docs:generate -- --watch\" \"npm run docs:serve\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.2",
    "@tauri-apps/api": "^1.5.3",
    "@tauri-apps/cli": "^1.5.9",
    "@yeger/vue-masonry-wall": "^5.0.5",
    "date-fns": "^3.2.0",
    "mediasoup-client": "^3.7.2",
    "pinia": "^2.1.7",
    "simple-peer": "^9.11.1",
    "uuidv4": "^6.2.13",
    "v3-color-picker": "^2.0.0",
    "vue": "^3.3.11",
    "vue-color-kit": "^1.0.6",
    "vue-drag-drop": "^1.1.4",
    "vue-easy-lightbox": "next",
    "vue-router": "^4.2.5",
    "vue-toastification": "next",
    "vue3-lazyload": "^0.3.8",
    "vuedraggable": "next"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.3.3",
    "@tsconfig/node18": "^18.2.2",
    "@types/node": "^18.19.119",
    "@vitejs/plugin-vue": "^4.5.2",
    "@vue/eslint-config-prettier": "^8.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/tsconfig": "^0.5.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.49.0",
    "eslint-plugin-vue": "^9.17.0",
    "markdownlint-cli": "^0.37.0",
    "npm-run-all2": "^6.1.1",
    "prettier": "^3.0.3",
    "typedoc": "^0.25.7",
    "typedoc-plugin-mermaid": "^1.10.0",
    "typedoc-plugin-vue": "^1.2.0",
    "typescript": "~5.3.0",
    "vite": "^5.0.10",
    "vitepress": "^1.6.3",
    "vue-tsc": "^1.8.25"
  }
}
