# =====================================================
# Bot Gateway Environment Configuration
# =====================================================

# Internal Supabase URL (can be localhost for efficiency)
# Used for database queries, RLS, and internal operations
SUPABASE_URL=http://localhost:8000

# Service role key for bypassing RLS policies
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Public-facing URL for external services
# Used for avatars, attachments, and other public resources
# This should be your production domain for external services like Discord
PUBLIC_URL=https://your-public-domain.com

# Server configuration
PORT=3002
NODE_ENV=development

# Discord bridge v2
# Shared secret of the bridge host (X-Bridge-Host-Secret); unset or under 32 characters disables GET /bridge/v2/hosted.
BRIDGE_HOST_SECRET=
# Express trust proxy for client IPs behind nginx: hop count, true/false, or address list. Default: loopback, linklocal, uniquelocal.
TRUST_PROXY=
# Milliseconds between bridge configuration checks for BRIDGE_CONFIG_UPDATE (1000-60000, default 5000).
BRIDGE_CONFIG_POLL_MS=5000
