# =============================================================================
# Harmony bot gateway, development values
# =============================================================================
# Copy to .env. env.template holds production values. Loader:
# src/config/supabase.ts, plus direct reads in src/api/BotRestAPI.ts and
# src/utils. A commented line shows the default.
# =============================================================================

# --- Supabase (required) ------------------------------------------------------
# API URL as this process reaches it: http://supabase-kong:8000 on Supabase's Docker network.
SUPABASE_URL=http://localhost:8000
# Service role key. Secret; every query bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Public Supabase origin, substituted for SUPABASE_URL in storage URLs handed to bots and bridges.
# PUBLIC_URL=<SUPABASE_URL>

# --- Instance -----------------------------------------------------------------
# Harmony app origin (hostname or URL, https assumed); base of the bridge pairing URLs.
INSTANCE_DOMAIN=http://localhost:5173
# Federation backend for link previews of bot messages; https or localhost only.
FEDERATION_BACKEND_URL=http://localhost:3001
# Bearer secret of the link-preview request, equal to the federation backend's; empty: the service role key.
INTERNAL_API_SECRET=

# --- Server -------------------------------------------------------------------
# development returns error messages in 500 responses.
NODE_ENV=development
# HTTP and WebSocket port.
PORT=3002
# Express `trust proxy`: hop count, true/false, or address list.
# TRUST_PROXY=loopback, linklocal, uniquelocal
# REST rate limit window, ms.
# RATE_LIMIT_WINDOW_MS=60000
# REST requests per bot, route and channel or server, per window.
# RATE_LIMIT_MAX_REQUESTS=100

# --- Gateway ------------------------------------------------------------------
# Heartbeat interval sent in READY, ms; a connection silent for twice this closes.
# WS_HEARTBEAT_INTERVAL=30000
# Recheck of open connections against bot_tokens and bots, ms, clamped to 1000-60000.
# WS_REVALIDATE_INTERVAL_MS=30000

# --- Discord bridge v2 --------------------------------------------------------
# Shared secret of the bridge host (X-Bridge-Host-Secret); under 32 characters disables GET /bridge/v2/hosted.
BRIDGE_HOST_SECRET=
# Bridge configuration poll for BRIDGE_CONFIG_UPDATE, ms, clamped to 1000-60000.
# BRIDGE_CONFIG_POLL_MS=5000
