{
  "name": "@harmony/bot-gateway",
  "version": "1.3.0",
  "description": "Harmony Bot API Gateway - WebSocket and REST API for bots",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "build-only": "tsc --skipLibCheck || true",
    "start": "node dist/index.js",
    "type-check": "tsc -p tsconfig.typecheck.json",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src/**/*.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:db": "vitest run --config vitest.db.config.ts"
  },
  "keywords": [
    "harmony",
    "bot",
    "api",
    "gateway",
    "discord"
  ],
  "author": "",
  "license": "AGPL-3.0",
  "dependencies": {
    "@supabase/supabase-js": "^2.84.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^24.19.2",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^8.56.0",
    "prettier": "^3.2.4",
    "supertest": "^7.2.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vite": "^6.4.6",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
