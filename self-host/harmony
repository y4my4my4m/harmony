#!/usr/bin/env bash
# =============================================================================
# harmony - operator commands for a self-hosted Harmony instance
# =============================================================================
#   harmony install                 install, or re-run safely (install.sh)
#   harmony update [--version V]    update code, images and database (update.sh);
#                                   V: X.Y.Z, a tag, a branch, or edge
#   harmony doctor [--offline]      check the instance (doctor.sh)
#   harmony backup [--no-storage]   database, configuration and uploads into
#                                   self-host/backups/<time>/
#   harmony restore <backup> [--yes]
#   harmony repair                  after a full disk: empties container logs
#                                   over 100 MB, repairs a Redis append-only
#                                   file Redis cannot load, starts the stack
#   harmony status                  containers, version, URL
#   harmony logs [service] [-n N] [--no-follow]
#                                   federation = server + worker
#   harmony admin create [--email E] [--username U] [--password P]
#   harmony admin reset-password (--email E | --username U) [--password P]
#   harmony admin invite <email> [--send]
#   harmony registration [open | invite | closed]
#   harmony auth providers          sign-in providers, how each treats existing accounts and
#                                   whom its first sign-in makes an account for
#   harmony auth add-provider ID --name N --issuer URL --client-id C [...]
#                                   add or update one (OIDC; OAuth 2.0 takes
#                                   --authorize-url, --token-url, --userinfo-url);
#                                   it reads userinfo, or the ID token with
#                                   --id-token (--userinfo switches back);
#                                   its accounts stay apart from existing ones
#                                   unless --link-existing-accounts
#   harmony auth remove-provider ID
#   harmony auth linking PROVIDER --separate-accounts | --link-existing-accounts
#                                   how discord, github, google, twitch, ... treat existing accounts
#   harmony auth sign-up PROVIDER --follow-registration | --open | --domains D[,D...]
#                                   whom a provider makes new accounts for: as registration
#                                   says, anyone it signs in, or verified addresses at D
#   harmony config                  change the answers (configure.sh), apply
#   harmony config --upload-ceiling [SIZE]
#                                   largest file storage accepts (500MB, 2GB);
#                                   the admin panel's upload limits stay under it
#   harmony analytics [on | off [--delete-logs]]
#                                   Supabase log collection (Logflare + vector);
#                                   without an argument, whether it runs
#   harmony studio [on | off]       Supabase Studio, the database UI; off by default;
#                                   without an argument, whether it runs
#   harmony bridges                 the chat bridges this instance runs for its communities
#   harmony bridges add discord | matrix | both
#                                   start one (turns the bot gateway on)
#   harmony bridges remove discord | matrix [--delete-data] [--yes]
#                                   stop one; communities' settings stay
#   harmony version
#
# Each command is a thin layer over the scripts beside this file.
# =============================================================================
set -euo pipefail
# Resolves a symlink (/usr/local/bin/harmony) to the checkout.
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
# shellcheck source=lib.sh
source "$(dirname "$SELF")/lib.sh"

usage() { sed -n '2,/^# Each command is a thin layer/p' "$SELF" | sed 's/^# \{0,1\}//'; }

need_config() { [[ -f "$ENV_FILE" ]] || die "not installed yet: $SELF_HOST_DIR/harmony install"; }

cmd_update() {
	local v=""
	while [[ $# -gt 0 ]]; do
		case "$1" in
			--version) v="${2:?--version needs a value}"; shift ;;
			--version=*) v="${1#--version=}" ;;
			*) die "unknown argument: $1" ;;
		esac
		shift
	done
	if [[ -n "$v" ]]; then
		case "$v" in
			edge) v=master ;;
			[0-9]*.[0-9]*.[0-9]*) v="v$v" ;;
		esac
		export HARMONY_REF="$v"
	fi
	exec bash "$SELF_HOST_DIR/update.sh"
}

cmd_status() {
	need_config
	local domain
	domain="$(env_get "$ENV_FILE" DOMAIN)"
	printf '%sHarmony%s  https://%s\n' "$c_bold" "$c_reset" "$domain"
	printf '  code       %s (%s)\n' "$(git -C "$REPO_DIR" describe --tags --always 2>/dev/null || echo '?')" \
		"$(git -C "$REPO_DIR" symbolic-ref -q --short HEAD 2>/dev/null || echo detached)"
	printf '  images     %s%s\n' "$(env_get "$ENV_FILE" HARMONY_VERSION)" \
		"$( [[ "$(env_get "$ENV_FILE" COMPOSE_FILE)" == *build* ]] && echo ' (built from this checkout)')"
	printf '  profiles   %s\n' "$(env_get "$ENV_FILE" COMPOSE_PROFILES | sed 's/^$/(none)/')"
	printf '  register   %s\n' "$(env_get "$ENV_FILE" REGISTRATION)"
	printf '  backup     %s\n' "$(basename "$(latest_backup)" 2>/dev/null | sed 's/^$/none/')"
	echo
	compose ps --format 'table {{.Service}}\t{{.Status}}\t{{.Image}}'
}

# Recovery after a full disk: space first (logs of containers created without rotation), then Redis,
# whose append-only file a cut-short write leaves unloadable, then every service. Nothing else is
# deleted; a repaired Redis file keeps its original beside it (redis_aof_repair, lib.sh).
cmd_repair() {
	need_config
	[[ $# -eq 0 ]] || die "usage: harmony repair"
	local dir free low=false
	info "Container logs..."
	trim_container_logs || true
	for dir in "$SELF_HOST_DIR" "$(docker_root)"; do
		[[ -n "$dir" ]] || continue
		free="$(free_kb "$dir")"
		[[ "$free" =~ ^[0-9]+$ ]] || continue
		if (( free < DISK_RESERVE_KB )); then
			warn "$(human_kb "$free") free on $(mount_of "$dir") ($dir): Postgres and Redis cannot start on a full disk."
			low=true
		fi
	done
	$low && die "free space first: old backups in $BACKUP_DIR can go once copied off this machine; docker image prune removes unused images. Then run harmony repair again."
	info "Redis..."
	redis_recover || true
	info "Starting the stack..."
	compose up -d
	redis_recover || true
	wait_healthy db 60 || warn "the database is not healthy yet: harmony logs db"
	compose ps --format 'table {{.Service}}\t{{.Status}}'
	ok "Done. Check the instance: harmony doctor. Then take a backup: harmony backup"
}

cmd_logs() {
	need_config
	local -a svcs=() opts=()
	local follow=true tail=200
	while [[ $# -gt 0 ]]; do
		case "$1" in
			-n) tail="${2:?-n needs a number}"; shift ;;
			--no-follow) follow=false ;;
			federation) svcs+=(federation-server federation-worker) ;;
			supabase) svcs+=(db auth rest realtime storage kong) ;;
			*) svcs+=("$1") ;;
		esac
		shift
	done
	if $follow; then opts+=(-f); fi
	compose logs ${opts[@]+"${opts[@]}"} --tail "$tail" ${svcs[@]+"${svcs[@]}"}
}

# FILE_SIZE_LIMIT in supabase/.env, storage recreated with it, and the same number in
# instance_config.upload_ceiling_bytes (lib.sh, upload ceiling).
cmd_upload_ceiling() {
	need_config
	local size="${1:-}" bytes over
	if [[ -z "$size" ]]; then
		bytes="$(upload_ceiling)"
		printf 'Upload ceiling: %s (FILE_SIZE_LIMIT=%s in supabase/.env)\n' "$(human_size "$bytes")" "$bytes"
		return
	fi
	bytes="$(parse_size "$size")" || die "upload ceiling: '$size' is not a size from 1MB to 5TB (500MB, 2GB, or bytes)"
	env_set "$SB_ENV" FILE_SIZE_LIMIT "$bytes"
	info "Recreating storage with FILE_SIZE_LIMIT=$bytes..."
	compose up -d storage
	db_sql -v bytes="$bytes" >/dev/null <<'SQL' || die "storage runs with FILE_SIZE_LIMIT=$bytes, but instance_config.upload_ceiling_bytes was not written; run this again once the database is up"
INSERT INTO public.instance_config (config_key, config_value, description)
VALUES ('upload_ceiling_bytes', to_jsonb(:'bytes'::bigint), 'storage-api FILE_SIZE_LIMIT, bytes; set by the instance operator')
ON CONFLICT (config_key) DO UPDATE SET config_value = EXCLUDED.config_value, updated_at = now();
SQL
	over="$(db_sql -v bytes="$bytes" <<'SQL' || true
SELECT string_agg(config_key || ' = ' || (config_value #>> '{}') || ' MB', ', ' ORDER BY config_key)
  FROM public.instance_config
 WHERE config_key IN ('upload_limit_user_mb', 'upload_limit_moderator_mb', 'upload_limit_admin_mb')
   AND jsonb_typeof(config_value) = 'number'
   AND (config_value #>> '{}')::numeric * 1048576 > :'bytes'::bigint;
SQL
)"
	[[ -z "$over" ]] || warn "above the new ceiling, so held to it: $over"
	ok "Upload ceiling: $(human_size "$bytes"). Admins set upload limits up to it in Admin, Config, Uploads."
}

cmd_config() {
	need_config
	case "${1:-}" in
		--upload-ceiling) shift; cmd_upload_ceiling "$@"; return ;;
		--upload-ceiling=*) cmd_upload_ceiling "${1#--upload-ceiling=}"; return ;;
		"") ;;
		*) die "unknown argument: $1 (harmony help)" ;;
	esac
	interactive || die "harmony config asks questions; for scripted changes run: HARMONY_...=... bash configure.sh --non-interactive"
	reconfigure ask
	ok "Configuration applied. Check it: harmony doctor"
}

# Runs configure.sh, asking its questions (ask) or keeping every answer the environment does not
# give (keep), and applies the change: containers of a profile turned off, images, the stack, the
# API's name in the database, the registration mode.
reconfigure() {
	local before_profiles after_profiles before_hosts after_hosts pair svc profile unchosen=false name_unchosen=false
	analytics_unchosen && unchosen=true
	instance_name_unchosen && name_unchosen=true
	before_profiles="$(env_get "$ENV_FILE" COMPOSE_PROFILES)"
	before_hosts="$(env_get "$ENV_FILE" DOMAIN) $(env_get "$ENV_FILE" DB_DOMAIN)"
	if [[ "$1" == ask ]]; then
		bash "$SELF_HOST_DIR/configure.sh" < /dev/tty
	else
		bash "$SELF_HOST_DIR/configure.sh" --non-interactive < /dev/null
	fi
	after_profiles="$(env_get "$ENV_FILE" COMPOSE_PROFILES)"
	after_hosts="$(env_get "$ENV_FILE" DOMAIN) $(env_get "$ENV_FILE" DB_DOMAIN)"
	if $unchosen && [[ ",$after_profiles," != *",logs,"* ]]; then analytics_default_off; fi
	# A disabled profile's container outlives `up -d`; remove it.
	for pair in livekit:voice bot-gateway:bots discord-bridge-host:discord matrix-bridge-host:matrix analytics:logs vector:logs; do
		svc="${pair%%:*}"; profile="${pair##*:}"
		if [[ ",$before_profiles," == *",$profile,"* && ",$after_profiles," != *",$profile,"* ]]; then
			info "Removing $svc (profile $profile turned off)"
			compose --profile "$profile" rm -sf "$svc" >/dev/null
		fi
	done
	info "Applying..."
	# keep: images already here stay at the version the database is migrated for; up -d pulls a missing one.
	if [[ "$1" == ask ]]; then compose pull --quiet --ignore-pull-failures >/dev/null 2>&1 || true; fi
	compose up -d
	# instance_config.storage_origin follows DB_DOMAIN.
	if [[ "$before_hosts" != "$after_hosts" ]]; then
		bash "$SELF_HOST_DIR/bootstrap.sh" --migrations-only
	fi
	if $name_unchosen; then
		wait_healthy db 30 || true
		instance_name_default_renamed
	fi
	if bash "$SELF_HOST_DIR/admin.sh" has-admin; then
		bash "$SELF_HOST_DIR/admin.sh" registration
	fi
}

# Chat bridges the instance runs: a compose profile and its service, started through configure.sh.
# Communities are offered them by the admin panel's switches (instance_config).
bridge_on() { [[ ",$(env_get "$ENV_FILE" COMPOSE_PROFILES)," == *",$1,"* ]]; }

bridge_label() { case "$1" in discord) printf Discord ;; matrix) printf Matrix ;; esac; }

# "'key', 'key'": the instance_config switches that offer communities their own account or bot run
# here, and the instance's.
bridge_switches() {
	case "$1" in
		discord) printf "'discord_bridge_hosting_enabled', 'discord_bridge_instance_bot_enabled'" ;;
		matrix) printf "'matrix_bridge_hosting_enabled', 'matrix_bridge_instance_enabled'" ;;
	esac
}

# "own instance": bridges communities run on the host. Empty when the database is down.
bridge_counts() {
	db_sql 2>/dev/null <<SQL || true
SELECT count(*) FILTER (WHERE mode = 'hosted') || ' ' || count(*) FILTER (WHERE mode = 'instance')
  FROM public.${1}_bridges;
SQL
}

# "own instance", each true or false: what the admin panel offers communities.
bridge_offers() {
	db_sql 2>/dev/null <<SQL || true
SELECT COALESCE(bool_or(config_key LIKE '%_hosting_enabled' AND config_value #>> '{}' = 'true'), false)
       || ' ' || COALESCE(bool_or(config_key NOT LIKE '%_hosting_enabled' AND config_value #>> '{}' = 'true'), false)
  FROM public.instance_config
 WHERE config_key IN ($(bridge_switches "$1"));
SQL
}

bridge_offer_at() { printf 'Instance admin, Config, General, %s bridge' "$(bridge_label "$1")"; }

# What a community connects and what the instance has, as the admin panel words them.
bridge_own() { case "$1" in discord) printf 'own bot' ;; matrix) printf 'own account' ;; esac; }
bridge_shared() { case "$1" in discord) printf "this instance's bot" ;; matrix) printf "this instance's bridge" ;; esac; }

bridge_status() {
	local platform="$1" label counts offers
	label="$(bridge_label "$platform")"
	if ! bridge_on "$platform"; then
		printf '%s: off. harmony bridges add %s runs it for your communities.\n' "$label" "$platform"
		return
	fi
	if [[ -n "$(svc_id "$platform-bridge-host")" ]]; then
		printf '%s: on.\n' "$label"
	else
		printf '%s: on, but %s-bridge-host is not running: harmony logs %s-bridge-host\n' "$label" "$platform" "$platform"
	fi
	counts="$(bridge_counts "$platform")"; offers="$(bridge_offers "$platform")"
	[[ -z "$counts" ]] || printf '  Run here:  %s with a community'"'"'s %s, %s with %s\n' "${counts% *}" "$(bridge_own "$platform")" "${counts#* }" "$(bridge_shared "$platform")"
	if [[ -n "$offers" ]]; then
		printf '  Offered:   %s %s, %s %s (%s)\n' "$(bridge_own "$platform")" "$(yes_or_no "${offers% *}")" \
			"$(bridge_shared "$platform")" "$(yes_or_no "${offers#* }")" "$(bridge_offer_at "$platform")"
	fi
}
yes_or_no() { if [[ "$1" == true ]]; then printf yes; else printf no; fi; }

bridges_status() {
	if bridge_on bots; then
		printf 'Bot gateway: on. Bots need it, and so do bridges people run themselves.\n'
	else
		printf 'Bot gateway: off. Nobody can run a bot or a bridge; harmony bridges add, or harmony config, turns it on.\n'
	fi
	bridge_status discord
	bridge_status matrix
}

bridges_add() {
	local usage="usage: harmony bridges add discord | matrix | both" platform platforms answer=() missing=false
	[[ $# -eq 1 ]] || die "$usage"
	case "$1" in
		discord|matrix) platforms="$1" ;;
		both) platforms="discord matrix" ;;
		*) die "$usage" ;;
	esac
	for platform in $platforms; do
		if bridge_on "$platform" && [[ -n "$(svc_id "$platform-bridge-host")" ]]; then
			ok "The $(bridge_label "$platform") bridge host already runs."
			continue
		fi
		missing=true
		answer+=("HARMONY_$(printf '%s' "$platform" | tr '[:lower:]' '[:upper:]')=y")
		info "Starting the $(bridge_label "$platform") bridge host..."
	done
	if $missing; then
		bridge_on bots || info "The bot gateway is turned on with it."
		(export HARMONY_BOTS=y "${answer[@]}"; reconfigure keep)
		ok "The bridge host runs."
	fi
	for platform in $platforms; do
		info "Communities see the $(bridge_label "$platform") bridge once you offer it in $(bridge_offer_at "$platform"):"
		info "their $(bridge_own "$platform") run here, or $(bridge_shared "$platform"), whose credentials go there too."
	done
}

bridges_remove() {
	local usage="usage: harmony bridges remove discord | matrix [--delete-data] [--yes]"
	local delete=false sure=false counts own=0 instance=0 platform="${1:-}" label volume
	case "$platform" in discord|matrix) shift ;; *) die "$usage" ;; esac
	label="$(bridge_label "$platform")"; volume="harmony_$platform-bridge-data"
	while [[ $# -gt 0 ]]; do
		case "$1" in
			--delete-data) delete=true ;;
			--yes) sure=true ;;
			*) die "unknown argument: $1 (harmony help)" ;;
		esac
		shift
	done
	if ! bridge_on "$platform" && ! $delete; then
		ok "The $label bridge host is off."
		return
	fi
	counts="$(bridge_counts "$platform")"
	[[ -z "$counts" ]] || { own="${counts% *}"; instance="${counts#* }"; }
	if [[ -z "$counts" ]]; then
		warn "the database does not answer, so how many communities' bridges stop is not known"
	elif (( own + instance > 0 )); then
		warn "$((own + instance)) communities' bridges stop: $own with their $(bridge_own "$platform"), $instance with $(bridge_shared "$platform")"
	fi
	$delete && warn "--delete-data deletes the bridge host's volume: $(bridge_volume_holds "$platform"), which cannot be recovered"
	if ! $sure && { $delete || [[ -z "$counts" ]] || (( own + instance > 0 )); }; then
		interactive || die "nothing was changed: add --yes to remove it without being asked"
		ask_yn "Remove the $label bridge host?" n || die "nothing was changed"
	fi
	# Off in the panel too: an offer without a host takes communities through a setup that cannot finish.
	db_sql >/dev/null 2>&1 <<SQL || warn "the offers in $(bridge_offer_at "$platform") were not turned off; turn them off there"
UPDATE public.instance_config SET config_value = 'false'::jsonb, updated_at = now()
 WHERE config_key IN ($(bridge_switches "$platform"));
SQL
	if bridge_on "$platform"; then
		(export "HARMONY_$(printf '%s' "$platform" | tr '[:lower:]' '[:upper:]')=n"; reconfigure keep)
	fi
	if $delete; then
		docker volume rm "$volume" >/dev/null || die "the host is removed, but its volume was not: docker volume rm $volume"
		ok "The $label bridge host and its data are removed."
	else
		ok "The $label bridge host is removed; its data stays."
	fi
	info "Communities keep their bridges' settings: harmony bridges add $platform, then $(bridge_offer_at "$platform")."
	bridge_on bots && info "The bot gateway stays on for bots and bridges people run themselves; harmony config turns it off."
	return 0
}
bridge_volume_holds() {
	case "$1" in
		discord) printf 'its emoji map and state' ;;
		matrix) printf 'which Matrix event is which Harmony message, so edits and deletions of earlier messages no longer cross' ;;
	esac
}

cmd_bridges() {
	need_config
	local action="${1:-}"
	[[ $# -gt 0 ]] && shift
	case "$action" in
		"") bridges_status ;;
		add) bridges_add "$@" ;;
		remove) bridges_remove "$@" ;;
		*) die "usage: harmony bridges [add discord | matrix | both, remove discord | matrix [--delete-data] [--yes]]" ;;
	esac
}

# Supabase log collection: ENABLE_ANALYTICS and the `logs` profile in .env. Off removes the
# containers (rm -s): a stopped container with a restart policy reads as a failure to monitors.
# --delete-logs deletes what Logflare keeps in the database (analytics_delete_logs, lib.sh).
cmd_analytics() {
	need_config
	local want="${1:-}" delete=false profiles size freed
	[[ $# -gt 0 ]] && shift
	while [[ $# -gt 0 ]]; do
		case "$1" in
			--delete-logs) delete=true ;;
			*) die "unknown argument: $1 (harmony help)" ;;
		esac
		shift
	done
	profiles="$(env_get "$ENV_FILE" COMPOSE_PROFILES)"
	case "$want" in
		"")
			$delete && die "--delete-logs goes with off: harmony analytics off --delete-logs"
			if [[ ",$profiles," == *",logs,"* ]]; then
				printf 'Supabase log collection: on (analytics, vector). harmony analytics off frees about %s of RAM.\n' "$ANALYTICS_RAM"
			else
				printf 'Supabase log collection: off. harmony analytics on starts it (about %s of RAM).\n' "$ANALYTICS_RAM"
			fi
			size="$(db_sql -d _supabase -c "SELECT pg_size_pretty(sum(pg_total_relation_size(c.oid))) FROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace WHERE n.nspname = '_analytics' AND c.relkind IN ('r', 'm')" 2>/dev/null || true)"
			[[ -z "$size" ]] || printf 'Stored logs (_supabase._analytics): %s\n' "$size"
			;;
		on)
			$delete && die "--delete-logs goes with off"
			env_set "$ENV_FILE" ENABLE_ANALYTICS true
			env_set "$ENV_FILE" COMPOSE_PROFILES "$(profiles_with "$profiles" logs on)"
			info "Starting analytics and vector..."
			compose up -d analytics vector
			ok "Supabase log collection is on; Studio's Logs pages fill from now on."
			;;
		off)
			env_set "$ENV_FILE" ENABLE_ANALYTICS false
			env_set "$ENV_FILE" COMPOSE_PROFILES "$(profiles_with "$profiles" logs off)"
			info "Removing analytics and vector..."
			compose --profile logs rm -sf analytics vector >/dev/null
			if $delete; then
				freed="$(analytics_delete_logs)" || die "the containers are removed, but the stored logs were not deleted; run this again once the database is up"
				ok "Stored logs, Logflare's publication and replication slots deleted: $freed freed."
			fi
			ok "Supabase log collection is off. harmony logs shows every service's logs."
			;;
		*) die "usage: harmony analytics [on | off [--delete-logs]]" ;;
	esac
}

# Supabase Studio: ENABLE_STUDIO and the `studio` profile in .env. Off removes the containers, as
# cmd_analytics does.
cmd_studio() {
	need_config
	local want="${1:-}" profiles url
	profiles="$(env_get "$ENV_FILE" COMPOSE_PROFILES)"
	url="https://$(env_get "$ENV_FILE" DB_DOMAIN)"
	case "$want" in
		"")
			if [[ ",$profiles," == *",studio,"* ]]; then
				printf 'Supabase Studio: on, at %s. harmony studio off stops it.\n' "$url"
			else
				printf 'Supabase Studio: off. harmony studio on starts it at %s.\n' "$url"
			fi
			;;
		on)
			env_set "$ENV_FILE" ENABLE_STUDIO true
			env_set "$ENV_FILE" COMPOSE_PROFILES "$(profiles_with "$profiles" studio on)"
			info "Starting studio and meta..."
			compose up -d studio meta
			ok "Supabase Studio: $url (user supabase, DASHBOARD_PASSWORD in supabase/.env)."
			warn "Anyone with that password can read and change the whole database. When you are done: harmony studio off"
			;;
		off)
			env_set "$ENV_FILE" ENABLE_STUDIO false
			env_set "$ENV_FILE" COMPOSE_PROFILES "$(profiles_with "$profiles" studio off)"
			info "Removing studio and meta..."
			compose --profile studio rm -sf studio meta >/dev/null
			ok "Supabase Studio is off."
			;;
		*) die "usage: harmony studio [on | off]" ;;
	esac
}

cmd="${1:-}"
[[ $# -gt 0 ]] && shift
case "$cmd" in
	install) exec bash "$SELF_HOST_DIR/install.sh" "$@" ;;
	update) cmd_update "$@" ;;
	doctor) exec bash "$SELF_HOST_DIR/doctor.sh" "$@" ;;
	backup) need_config; exec bash "$SELF_HOST_DIR/backup.sh" create "$@" ;;
	restore) exec bash "$SELF_HOST_DIR/backup.sh" restore "$@" ;;
	repair) cmd_repair "$@" ;;
	status) cmd_status ;;
	logs) cmd_logs "$@" ;;
	admin)
		need_config
		sub="${1:-}"; [[ $# -gt 0 ]] && shift
		case "$sub" in
			create|reset-password|invite) exec bash "$SELF_HOST_DIR/admin.sh" "$sub" "$@" ;;
			*) die "usage: harmony admin create | reset-password | invite" ;;
		esac ;;
	registration) need_config; exec bash "$SELF_HOST_DIR/admin.sh" registration "$@" ;;
	auth) need_config; exec bash "$SELF_HOST_DIR/admin.sh" auth "$@" ;;
	config) cmd_config "$@" ;;
	analytics) cmd_analytics "$@" ;;
	studio) cmd_studio "$@" ;;
	bridges) cmd_bridges "$@" ;;
	version) git -C "$REPO_DIR" describe --tags --always 2>/dev/null; env_get "$ENV_FILE" HARMONY_VERSION ;;
	-h|--help|help|"") usage ;;
	*) die "unknown command: $cmd (harmony help)" ;;
esac
