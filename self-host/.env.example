# =============================================================================
# self-host/.env (reference)
# =============================================================================
# configure.sh writes this file, together with federation.env, bot-gateway.env,
# discord-bridge.env, livekit.yaml and supabase/.env. Re-running it keeps every
# value already present. docker compose reads this file for interpolation;
# `docker compose up -d` applies a change.
# =============================================================================

# Public domain of the instance; the app is https://DOMAIN.
DOMAIN=chat.example.com
# Supabase API gateway (Kong).
DB_DOMAIN=db.chat.example.com
# LiveKit signalling; served only with ENABLE_VOICE=true.
LIVEKIT_DOMAIN=live.chat.example.com

INSTANCE_NAME=Harmony
# Let's Encrypt contact and VAPID_SUBJECT in federation.env.
ADMIN_EMAIL=admin@example.com

# A contact email (public Let's Encrypt certificates) or the word "internal"
# (Caddy's local CA, for LAN/NAS without public DNS).
CADDY_TLS=admin@example.com

ENABLE_VOICE=false
ENABLE_BOTS=false
ENABLE_DISCORD_BRIDGE=false
# open | invite | closed; `harmony registration` applies it.
REGISTRATION=open
# Read by docker compose: profiles `docker compose up -d` starts (voice, bots, discord).
COMPOSE_PROFILES=

# Tag of the ghcr.io/y4my4my4m/harmony-* images. configure.sh sets it from the
# checkout on every run: X.Y.Z at tag vX.Y.Z, otherwise edge.
HARMONY_VERSION=edge
# HARMONY_BUILD=1 configure.sh sets this to build Harmony's images locally:
# COMPOSE_FILE=docker-compose.yml:docker-compose.build.yml

# [address:]port Caddy publishes for 80 and 443.
HARMONY_HTTP_PORT=80
HARMONY_HTTPS_PORT=443

# Runtime web config: the web container writes /config.json from it.
SUPABASE_ANON_KEY=eyJhbGciOi...
# Optional, also read by the web container:
# ENABLED_OAUTH_PROVIDERS=google,github
# TERMS_URL=https://chat.example.com/terms
# PRIVACY_URL=https://chat.example.com/privacy

REDIS_PASSWORD=generated-by-configure

# Discord bridge image tag (its own versioning), default 2:
# DISCORD_BRIDGE_VERSION=2
