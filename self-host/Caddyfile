# =============================================================================
# Harmony reverse proxy (Caddy)
# =============================================================================
#   https://{$DOMAIN}          app (web) + federation backend + bot gateway
#   https://{$DB_DOMAIN}       Supabase API gateway (Kong)
#   https://{$LIVEKIT_DOMAIN}  LiveKit, defined only when ENABLE_VOICE=true
#
# {$CADDY_TLS} is a contact email (public ACME) or the word "internal" (Caddy's
# local CA, for LAN/NAS without public DNS).
#
# Routing mirrors dev/nginx-harmony.template.conf location by location. nginx
# matches paths case-sensitively, hence path_regexp below where Caddy's `path`
# matcher would fold case.
# =============================================================================

# X-Real-IP is the address the federation backend keys its rate limits on
# (TRUST_PROXY names the trusted peers). {client_ip} is the peer address unless
# global trusted_proxies is set, then the forwarded client.
(federation_upstream) {
	reverse_proxy federation-server:3001 {
		header_up X-Real-IP {client_ip}
	}
}

# Voice site, imported as voice-{$ENABLE_VOICE}. Without voice no site block
# exists for the live domain, so Caddy requests no certificate for it.
(voice-true) {
	{$LIVEKIT_DOMAIN} {
		tls {$CADDY_TLS}
		# WebSocket upgrades pass through; streams have no read timeout.
		reverse_proxy livekit:7880 {
			header_up X-Real-IP {client_ip}
		}
	}
}
(voice-false) {
}

# --- Main app + federation ---------------------------------------------------
{$DOMAIN} {
	tls {$CADDY_TLS}
	encode zstd gzip

	# nginx: client_max_body_size 50M.
	request_body {
		max_size 50MB
	}

	# nginx adds these on every response; `?` keeps a value the upstream set.
	# The YouTube relay is framed by the native apps and carries frame-ancestors instead.
	@notYouTubeRelay not path /youtube-embed.html
	header @notYouTubeRelay {
		?X-Frame-Options SAMEORIGIN
		?X-Content-Type-Options nosniff
		?X-XSS-Protection "1; mode=block"
		?Referrer-Policy strict-origin-when-cross-origin
	}

	# --- Federation backend ----------------------------------------------------

	# WebFinger, host-meta, NodeInfo discovery. CORS open as in nginx; the
	# deferred set replaces rather than duplicates a value from the backend.
	@fedDiscovery path_regexp ^/\.well-known/(webfinger|host-meta|host-meta\.json|nodeinfo)$
	handle @fedDiscovery {
		header Access-Control-Allow-Origin "*" {
			defer
		}
		import federation_upstream
	}

	@fedNodeinfo path_regexp ^/nodeinfo/2\.(0|1)$
	handle @fedNodeinfo {
		header Access-Control-Allow-Origin "*" {
			defer
		}
		import federation_upstream
	}

	# Shared inbox, oEmbed, actor collections, Group actors, post collections:
	# always ActivityPub. Outboxes are per actor; no shared outbox exists.
	@fedExact path_regexp ^/(inbox|oembed)$
	handle @fedExact {
		import federation_upstream
	}
	@fedActorCollections path_regexp ^/users/[^/]+/(inbox|outbox|followers|following|featured)$
	handle @fedActorCollections {
		import federation_upstream
	}
	@fedServers path_regexp ^/servers/
	handle @fedServers {
		import federation_upstream
	}
	@fedPostCollections path_regexp ^/posts/[0-9a-f-]+/(likes|replies)
	handle @fedPostCollections {
		import federation_upstream
	}

	# Post permalinks: the backend negotiates (AP Note JSON for fediverse
	# clients, HTML with OpenGraph tags for browsers and crawlers).
	@fedPost path_regexp ^/posts/[0-9a-f-]+$
	handle @fedPost {
		import federation_upstream
	}

	# Actor profile: ActivityPub clients get the actor, browsers the in-app
	# profile. nginx tests Accept with ~* (case-insensitive).
	@fedActor {
		path_regexp ^/users/[^/]+$
		header_regexp Accept (?i)application/(activity\+json|ld\+json|json)
	}
	handle @fedActor {
		import federation_upstream
	}
	@humanActor {
		path_regexp humanActor ^/users/([^/]+)$
		not header_regexp Accept (?i)application/(activity\+json|ld\+json|json)
	}
	handle @humanActor {
		# `*`: a first argument starting with / would parse as a path matcher.
		redir * /social/profile/{re.humanActor.1} 302
	}

	# Prefix locations without a trailing slash in nginx: /health matches
	# /health/maintenance, /link-preview matches /link-preview/enrich-message.
	@fedPrefix path_regexp ^/(health|link-preview)
	handle @fedPrefix {
		import federation_upstream
	}

	# LiveKit token API: mounted at /api/livekit on the backend, no rewrite.
	@fedLivekit path_regexp ^/api/livekit/
	handle @fedLivekit {
		import federation_upstream
	}

	# Federation API: the backend mounts most routes at the root only
	# (/lookup-user, /gifs/*, /invites/*, /instances/probe, /health/*, ...).
	# nginx: `location /api/federation/ { proxy_pass http://localhost:3001/; }`.
	@fedApi path_regexp ^/api/federation/
	handle @fedApi {
		uri strip_prefix /api/federation
		import federation_upstream
	}

	# Donation webhooks (Ko-fi posts form-encoded bodies). nginx caps them at 64k.
	@fedWebhooks path_regexp ^/webhooks/
	handle @fedWebhooks {
		request_body {
			max_size 64KB
		}
		import federation_upstream
	}

	# --- Bot gateway (bots profile) --------------------------------------------
	# /bot-gateway/gateway is the WebSocket; the rest is the REST API. Both map
	# to the gateway's root, as nginx's `proxy_pass http://localhost:3002/;`.
	@botGateway path_regexp ^/bot-gateway/
	handle @botGateway {
		uri strip_prefix /bot-gateway
		reverse_proxy bot-gateway:3002 {
			header_up X-Real-IP {client_ip}
		}
	}

	# nginx answers a proxied prefix location requested without its trailing
	# slash with a 301 to the slashed form, query kept.
	@slashless path_regexp ^/(api/livekit|api/federation|webhooks|bot-gateway)$
	handle @slashless {
		redir * {path}/{?query} 301
	}

	# --- Frontend ----------------------------------------------------------------
	# The web container serves the SPA with its own index.html fallback and
	# cache headers (self-host/web-nginx.conf).
	handle {
		reverse_proxy web:80
	}
}

# --- Supabase API gateway ----------------------------------------------------
{$DB_DOMAIN} {
	tls {$CADDY_TLS}

	# GoTrue's /logout accepts an aal1 token, and its global and others scopes
	# delete every session of the account: a password without the second factor
	# would sign every device out. Only ?scope=local passes; a missing scope is
	# GoTrue's global default. Other devices are signed out through
	# public.sign_out_my_sessions(). Same rule as dev/nginx-auth-logout.template.conf.
	# The path matcher compares the decoded, cleaned path, case-insensitively.
	@logoutScope {
		path /auth/v1/logout /auth/v1/logout/
		not method OPTIONS
		not expression {http.request.uri.query} == "scope=local"
	}
	handle @logoutScope {
		header Content-Type application/json
		header Access-Control-Allow-Origin *
		header Cache-Control no-store
		respond `{"code":403,"error_code":"logout_scope_forbidden","msg":"Only this device can be signed out here. Sign out other devices from Settings, Sessions."}` 403
	}

	# imgproxy answers a public render in WebP when Accept names image/webp and
	# in the source format otherwise, under one ETag and without Vary. A cache
	# in front (Cloudflare) would serve one client's format to all; the pinned
	# Accept makes every render WebP. Every Harmony client decodes WebP. Same
	# rule as the nginx Accept pin in docs/self-hosting.md.
	@publicRender path /storage/v1/render/image/public/*
	request_header @publicRender Accept "image/webp,*/*;q=0.8"

	reverse_proxy supabase-kong:8000
}

import voice-{$ENABLE_VOICE:false}
