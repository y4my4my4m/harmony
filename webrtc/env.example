# =============================================================================
# LiveKit Server Configuration
# =============================================================================

# API Key and Secret for LiveKit authentication
# Generate with: openssl rand -hex 32
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# LiveKit WebSocket URL (for clients)
# Development: ws://localhost:7880
# Production: wss://livekit.yourdomain.com
LIVEKIT_URL=ws://localhost:7880

# =============================================================================
# Public-facing URLs (for federation)
# =============================================================================

# Your instance's public domain
INSTANCE_DOMAIN=localhost

# Public LiveKit WebSocket URL (what remote instances connect to)
# Must be accessible from the internet for federation
LIVEKIT_PUBLIC_URL=wss://livekit.yourdomain.com

# =============================================================================
# TURN Server Configuration
# =============================================================================

# TURN server domain (for NAT traversal)
TURN_DOMAIN=turn.yourdomain.com

# External TURN credentials (if using external TURN server)
# TURN_USERNAME=
# TURN_PASSWORD=

# =============================================================================
# Redis Configuration
# =============================================================================

REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD=

# =============================================================================
# Egress (Recording) Configuration
# =============================================================================

# Enable egress service for recording/streaming
ENABLE_EGRESS=false

# S3 storage for recordings (production)
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=us-west-2
# S3_BUCKET=harmony-recordings

# =============================================================================
# Performance Tuning
# =============================================================================

# Maximum participants per room (0 = unlimited)
MAX_PARTICIPANTS=0

# Room empty timeout (seconds)
EMPTY_ROOM_TIMEOUT=300

# =============================================================================
# Security
# =============================================================================

# Webhook secret for validating callbacks
# WEBHOOK_SECRET=

# Token TTL (seconds) - how long room tokens are valid
TOKEN_TTL=86400

