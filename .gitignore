# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
.DS_Store
dist
dist-ssr
coverage
*.local

# Rust / Tauri build output (subdir .gitignore covers git, this line is so
# top-level tools like eslint that read root .gitignore skip it too)
src-tauri/target/

# VitePress build output (cache is below)
docs/.vitepress/dist/

# Output of the retired docs generators; stale copies in older checkouts.
# docs/.vitepress/config.ts excludes them from the build as well.
docs/api/
docs/components/
docs/generated/
docs/guide/

# Internal orientation notes, not part of the published site
docs/SETTINGS_NAVIGATION_GUIDE.md
docs/VITEPRESS_SETUP.md

/cypress/videos/
/cypress/screenshots/

# Local editor/tooling session artifacts
.cursor/
.claude/

# Lockfiles for package managers we don't standardize on (project uses npm)
bun.lockb

# -----------------------------------------------------------------------------
# Instance-customizable assets
# -----------------------------------------------------------------------------
# Background images: the repo ships a small default set; instance operators
# drop additional images into these folders before `npm run build`
# (vite-plugin-backgrounds.ts lists them). Only the numbered defaults are committed.
public/backgrounds/login/*.webp
!public/backgrounds/login/1.webp
!public/backgrounds/login/2.webp
!public/backgrounds/login/3.webp
!public/backgrounds/login/4.webp
!public/backgrounds/login/5.webp
!public/backgrounds/login/6.webp
!public/backgrounds/login/7.webp
!public/backgrounds/login/8.webp
!public/backgrounds/login/9.webp
public/backgrounds/404/*.webp
!public/backgrounds/404/1.webp
!public/backgrounds/404/2.webp
public/backgrounds/offline/*.webp
!public/backgrounds/offline/1.webp
!public/backgrounds/offline/2.webp

# Optional emoji packs: instance operators can drop their own packs under
# public/assets/emojis/<pack>/. The repo only ships Twemoji as a default.

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

*.tsbuildinfo


.env
.env.dev
.env.stg.
.env.prod
.env.production
.env.test

.venv/


docs/.vitepress/cache
docker
# docker-compose.yml

# Local dev certificates (generated by mkcert)
dev/certs/*.pem

# Deployment configs generated from dev/*.template.conf; they carry real
# hostnames and certificate paths.
dev/*.conf
!dev/*.template.conf

# public/assets/emojis/*

webrtc/livekit.yaml
webrtc/docker-compose.yml

tmp/*

# Playwright test output
playwright-report/
test-results/
tests/e2e/.auth/

# HAR debug files
*.har

# Android release signing (CI-generated, never commit)
*.keystore
*.jks
src-tauri/gen/android/app/keystore.properties

# Local-only copy of BUGS.md with exact file:line locations
BUGS.local.md

# Python bytecode from the db tooling in scripts/test-db
__pycache__/
*.pyc

# Supabase CLI scratch (version check cache)
supabase/.temp/
